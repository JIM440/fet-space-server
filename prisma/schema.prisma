generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  Student
  Teacher
  Admin
}

enum FileType {
  pdf
  docx
  doc
  img
  ppt
  video
}

enum PollType {
  general
  course
}

model User {
  user_id       Int             @id @default(autoincrement())
  name          String
  email         String          @unique
  password      String
  phone_number  String?
  role          Role
  refreshToken  String?
  student       Student?
  teacher       Teacher?
  admin         Admin?
  comments      Comment[]
  notifications Notification[]
  pollResponses Poll_Response[]
  created_at    DateTime        @default(now()) // Added
}

model Teacher {
  user_id             Int                   @id
  user                User                  @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  createdCourses      Course[]
  assignments         Assignment[]
  courseAnnouncements Course_Announcement[]
  courseTeachers      Course_Teacher[]
  created_at          DateTime              @default(now()) // Added
}

model Student {
  user_id             Int                     @id
  user                User                    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  matricule_number    String                  @unique
  nationality         String?
  level               String
  institutional_email String                  @unique
  courseStudents      Course_Student[]
  submissions         Assignment_Submission[]
  created_at          DateTime                @default(now()) // Added
}

model Admin {
  user_id              Int                    @id
  user                 User                   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  generalAnnouncements General_Announcement[]
  created_at           DateTime               @default(now())
    is_super_admin       Boolean                @default(false)
  }

model Course {
  course_id         Int                   @id @default(autoincrement())
  title             String
  subtitle          String?
  code              String
  description       String @db.Text
  join_code         String                @unique // Ensure uniqueness
  teacher_id        Int
  teacher           Teacher               @relation(fields: [teacher_id], references: [user_id], onDelete: Restrict)
  courseTeachers    Course_Teacher[]
  courseStudents    Course_Student[]
  assignments       Assignment[]
  courseContents    Course_Content[]
  revisionQuestions Revision_Question[]
  announcements     Course_Announcement[]
  created_at        DateTime              @default(now()) // Added
}

model Course_Teacher {
  course_id  Int
  teacher_id Int
  course     Course  @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  teacher    Teacher @relation(fields: [teacher_id], references: [user_id], onDelete: Cascade)
  created_at DateTime @default(now()) // Added

  @@id([course_id, teacher_id])
}

model Course_Student {
  course_id  Int
  student_id Int
  course     Course  @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  student    Student @relation(fields: [student_id], references: [user_id], onDelete: Cascade)
  created_at DateTime @default(now()) // Added

  @@id([course_id, student_id])
}

model Assignment {
  assignment_id Int                     @id @default(autoincrement())
  course_id     Int
  title         String
  description   String @db.Text
  teacher_id    Int
  due_date      DateTime?
  course        Course                  @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  teacher       Teacher                 @relation(fields: [teacher_id], references: [user_id], onDelete: Restrict)
  submissions   Assignment_Submission[]
  comments      Comment[]
  attachments   Attachment[]
  notifications Notification[]
  created_at    DateTime                @default(now()) // Added
}

model Assignment_Submission {
  submission_id          Int          @id @default(autoincrement())
  assignment_id          Int
  student_id             Int
  submitted_at           DateTime     @default(now()) @updatedAt // Updatable timestamp
  comment                String?      // Optional comment
  assignment             Assignment   @relation(fields: [assignment_id], references: [assignment_id], onDelete: Cascade)
  student                Student      @relation(fields: [student_id], references: [user_id], onDelete: Cascade)
  attachments            Attachment[]
  created_at             DateTime     @default(now())
}

model Course_Content {
  content_id    Int            @id @default(autoincrement())
  course_id     Int
  course        Course         @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  attachments   Attachment[]
  notifications Notification[]
  created_at    DateTime       @default(now()) // Added
}

model Revision_Question {
  question_id Int          @id @default(autoincrement())
  course_id   Int
  file_url    String?
  course      Course       @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  attachments Attachment[]
  created_at  DateTime     @default(now()) // Added
}

model Course_Announcement {
  announcement_id Int            @id @default(autoincrement())
  course_id       Int
  teacher_id      Int
  title           String?
  content         String @db.Text?
  is_poll         Boolean        @default(false)
  created_at      DateTime       @default(now())
  course          Course         @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  teacher         Teacher        @relation(fields: [teacher_id], references: [user_id], onDelete: Restrict)
  poll            Poll?
  comments        Comment[]
  attachments     Attachment[]
  notifications   Notification[]
}

model General_Announcement {
  announcement_id Int            @id @default(autoincrement())
  admin_id        Int
  title           String?
  content         String @db.Text
  is_poll         Boolean        @default(false)
  created_at      DateTime       @default(now())
  admin           Admin          @relation(fields: [admin_id], references: [user_id], onDelete: Restrict)
  poll            Poll?
  comments        Comment[]
  attachments     Attachment[]
  notifications   Notification[]
}

model Poll {
  poll_id                 Int                   @id @default(autoincrement())
  general_announcement_id Int?                  @unique
  course_announcement_id  Int?                  @unique
  allow_multiple_answers  Boolean
  type                    PollType
  general_announcement    General_Announcement? @relation(fields: [general_announcement_id], references: [announcement_id], onDelete: Cascade)
  course_announcement     Course_Announcement?  @relation(fields: [course_announcement_id], references: [announcement_id], onDelete: Cascade)
  options                 Poll_Option[]
  responses               Poll_Response[]
  created_at              DateTime              @default(now()) // Added
}

model Poll_Option {
  option_id Int             @id @default(autoincrement())
  poll_id   Int
  content   String
  poll      Poll            @relation(fields: [poll_id], references: [poll_id], onDelete: Cascade)
  responses Poll_Response[]
  created_at DateTime       @default(now()) // Added
}

model Poll_Response {
  response_id    Int         @id @default(autoincrement())
  poll_id        Int
  poll_option_id Int
  user_id        Int
  responded_at   DateTime    @default(now())
  poll           Poll        @relation(fields: [poll_id], references: [poll_id], onDelete: Cascade)
  option         Poll_Option @relation(fields: [poll_option_id], references: [option_id], onDelete: Cascade)
  user           User        @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  created_at     DateTime    @default(now()) // Added
}

model Comment {
  comment_id              Int                   @id @default(autoincrement())
  user_id                 Int
  assignment_id           Int?
  general_announcement_id Int?
  course_announcement_id  Int?
  content                 String
  created_at              DateTime              @default(now())
  user                    User                  @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  assignment              Assignment?           @relation(fields: [assignment_id], references: [assignment_id], onDelete: Cascade)
  general_announcement    General_Announcement? @relation(fields: [general_announcement_id], references: [announcement_id], onDelete: Cascade)
  course_announcement     Course_Announcement?  @relation(fields: [course_announcement_id], references: [announcement_id], onDelete: Cascade)
}

model Attachment {
  attachment_id            Int                    @id @default(autoincrement())
  url                      String
  file_type                FileType
  course_content_id        Int?
  assignment_id            Int?
  assignment_submission_id Int?
  general_announcement_id  Int?
  course_announcement_id   Int?
  revision_questions_id    Int?
  course_content           Course_Content?        @relation(fields: [course_content_id], references: [content_id], onDelete: Cascade)
  assignment               Assignment?            @relation(fields: [assignment_id], references: [assignment_id], onDelete: Cascade)
  assignment_submission    Assignment_Submission? @relation(fields: [assignment_submission_id], references: [submission_id], onDelete: Cascade)
  general_announcement     General_Announcement?  @relation(fields: [general_announcement_id], references: [announcement_id], onDelete: Cascade)
  course_announcement      Course_Announcement?   @relation(fields: [course_announcement_id], references: [announcement_id], onDelete: Cascade)
  revision_question        Revision_Question?     @relation(fields: [revision_questions_id], references: [question_id], onDelete: Cascade)
  created_at               DateTime               @default(now()) // Added
}

model Notification {
  notification_id         Int      @id @default(autoincrement())
  user_id                 Int
  is_read                 Boolean  @default(false)
  message                 String
  assignment_id           Int?
  course_content_id       Int?
  course_announcement_id  Int?
  general_announcement_id Int?
  created_at              DateTime @default(now())

  user                 User                  @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  assignment           Assignment?           @relation(fields: [assignment_id], references: [assignment_id], onDelete: Cascade)
  course_content       Course_Content?       @relation(fields: [course_content_id], references: [content_id], onDelete: Cascade)
  course_announcement  Course_Announcement?  @relation(fields: [course_announcement_id], references: [announcement_id], onDelete: Cascade)
  general_announcement General_Announcement? @relation(fields: [general_announcement_id], references: [announcement_id], onDelete: Cascade)
}